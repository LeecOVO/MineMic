TEAM_ID=
OTHER_LDFLAGS = $(inherited) -lc++

// The shared Kotlin framework currently supports Apple Silicon simulators only.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64

PRODUCT_NAME=MineMic
PRODUCT_BUNDLE_IDENTIFIER=com.aiaixyz.minemic

#include "../../version.xcconfig"

// Optional signing settings for this checkout; never commit the local file.
#include? "Local.xcconfig"
